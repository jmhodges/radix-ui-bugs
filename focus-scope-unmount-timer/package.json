{
  "name": "focus-scope-unmount-timer-repro",
  "private": true,
  "version": "0.0.0",
  "description": "Reproduction: @radix-ui/react-focus-scope's unmount setTimeout fires after Vitest tears down jsdom",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:no-race": "REPRO_FORCE_RACE=0 vitest run",
    "test:fixed": "node scripts/make-fixed.mjs && REPRO_USE_FIX=1 vitest run",
    "jsdom-mechanism": "node jsdom-mechanism.cjs",
    "test:workaround": "REPRO_WORKAROUND=1 REPRO_FORCE_RACE=0 vitest run",
    "test:log": "REPRO_LOG_TIMER=1 vitest run",
    "postinstall": "node scripts/make-fixed.mjs",
    "make-fixed": "node scripts/make-fixed.mjs"
  },
  "devDependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-focus-scope": "1.1.16",
    "@radix-ui/react-popover": "1.1.23",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "jsdom": "24.1.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "vite": "7.3.6",
    "vitest": "4.1.6"
  },
  "overrides": {
    "nwsapi": "2.2.16"
  }
}
